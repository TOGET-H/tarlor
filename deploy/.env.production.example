# Copy to the project root as .env.production. Keep real keys on the server.
ORACLE_HTTP_PORT=8080
NUXT_TTS_ENABLED=true
NUXT_TTS_DEFAULT_CHANNEL=edge
NUXT_TTS_VOICE=zh-CN-YunxiNeural
NUXT_TTS_RATE=+0%
NUXT_TTS_MEDITATION_RATE=-15%
NUXT_TTS_PITCH=+0Hz
NUXT_TTS_TIMEOUT_MS=30000
NUXT_TTS_PROXY=
NUXT_AI_DEFAULT_CHANNEL=siliconflow
NUXT_AI_FALLBACK_TO_MOCK=true
NUXT_AI_CHANNELS_SILICONFLOW_API_KEY=
NUXT_AI_CHANNELS_SILICONFLOW_MODEL=Pro/zai-org/GLM-4.7
NUXT_AI_CHANNELS_SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/chat/completions
NUXT_AI_CHANNELS_DEEPSEEK_API_KEY=
NUXT_AI_CHANNELS_DEEPSEEK_MODEL=deepseek-chat
NUXT_AI_CHANNELS_DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
NUXT_AI_CHANNELS_GLM_API_KEY=
NUXT_AI_CHANNELS_GLM_MODEL=glm-4.7
NUXT_AI_CHANNELS_GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
